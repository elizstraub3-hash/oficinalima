# Focus NFe — https://focusnfe.com.br
# No painel da Focus: cadastre a empresa, envie o certificado A1 (.pfx) e copie o token
FOCUS_TOKEN=seu_token_aqui

# homologacao (teste, sem valor fiscal) ou producao
FOCUS_AMBIENTE=homologacao

# CNPJ da empresa emitente (somente números)
CNPJ_EMITENTE=46298746000124

# CSOSN do ICMS — 102 é o padrão do Simples Nacional. Confirme com o contador.
ICMS_CSOSN=102

PORT=3001
FRONTEND_URL=http://localhost:5173
