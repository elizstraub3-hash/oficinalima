# Credenciais da Nuvem Fiscal
# Cadastre-se em: https://nuvemfiscal.com.br
# Após criar conta, acesse: Configurações > API > Gerar chave
NUVEM_FISCAL_CLIENT_ID=seu_client_id_aqui
NUVEM_FISCAL_CLIENT_SECRET=seu_client_secret_aqui

# CNPJ da oficina (somente números, sem pontos/barras)
CNPJ_EMITENTE=00000000000000

# Porta do servidor (padrão 3001)
PORT=3001

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173
